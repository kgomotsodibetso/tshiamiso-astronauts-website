# PayFast
NEXT_PUBLIC_PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase

# Monday.com
MONDAY_API_TOKEN=your_monday_api_token
MONDAY_VOLUNTEER_BOARD_ID=your_board_id
MONDAY_CONTACT_BOARD_ID=your_board_id
MONDAY_EVENTS_BOARD_ID=your_board_id
MONDAY_RSVP_BOARD_ID=your_board_id
MONDAY_BLOG_BOARD_ID=your_board_id
# Donations register (TA_Donations_Register_2026). Optional: defaults to 5105898212.
# The token's monday user must be a subscriber of this private board.
MONDAY_DONATIONS_BOARD_ID=5105898212

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_NOTIFY_NUMBER=+27xxxxxxxxx

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# Resend (transactional email)
RESEND_API_KEY=your_resend_api_key

# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.org

# Subscribe / newsletter (double opt-in)
# RESEND_API_KEY (above) stays as it is for the contact form.
# The subscribe routes use their own full-access key (contacts, segments, events): ta-website-subscribe.
RESEND_SUBSCRIBE_API_KEY=your_full_access_resend_key
# MONDAY_API_TOKEN needs write access to the TA Newsletter Audience board (5105768584).
SUBSCRIBE_TOKEN_SECRET=random_32_byte_secret   # e.g. openssl rand -base64 32
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Local testing only: Cloudflare's always-pass keys are 1x00000000000000000000AA (site) and 1x0000000000000000000000000000000AA (secret)
SUBSCRIBE_POPUP_ENABLED=true   # set to false (and redeploy) to switch the blog pop-up off

# Board recruitment page (/board). Cowork supplies the two live Monday.com form links.
# Until both are set, preview buttons point at a placeholder and the page shows a "forms not yet open" ribbon.
BOARD_APPLY_URL=https://forms.monday.com/...
BOARD_NOMINATE_URL=https://forms.monday.com/...
# Set to true only once both forms have a hidden Source question. Then ?s=<code> is added to the form links.
BOARD_PASS_SOURCE=false
